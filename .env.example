# Copy to .env and fill in. .env is gitignored — never commit keys.

# --- LLM providers (all serve Qwen3-32B; tried in LLM_PROVIDERS order) ---
# Free keys: https://console.groq.com/keys  and  https://cloud.cerebras.ai
GROQ_API_KEY=
CEREBRAS_API_KEY=
LLM_PROVIDERS=groq,cerebras

# vLLM on Sharanga (used for the benchmark): tunnel with
#   ssh -N -L 8000:<gpu-node>:8000 sharanga
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-32B

# --- FalkorDB ---
FALKOR_HOST=localhost
FALKOR_PORT=6379
BASE_GRAPH=bidbrain_base

# --- optional ---
# BIDBRAIN_REPLAY=1     # answer only from the recorded LLM cache (offline demo)
# SESSION_TTL=86400     # seconds a visitor's graph copy survives inactivity
# CORS_ORIGINS=*
