# Copy to .env and fill in. .env is gitignored — never commit keys.

# --- LLM providers: a pool of (provider:model) quota buckets, rotated on rate limits ---
# Free keys: https://console.groq.com/keys  and  https://cloud.cerebras.ai
GROQ_API_KEY=
CEREBRAS_API_KEY=
LLM_PROVIDERS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,cerebras:gpt-oss-120b

# vLLM on Sharanga (used for the benchmark). The login node refuses TCP forwarding (ssh -L), so
# scripts/bench_when_ready.sh relays localhost:8011 through `nc <gpu-node> 8011` on the login node.
VLLM_BASE_URL=http://localhost:8011/v1
VLLM_MODEL=Qwen/Qwen3-32B

# --- FalkorDB ---
FALKOR_HOST=localhost
FALKOR_PORT=6379
BASE_GRAPH=bidbrain_base

# --- optional ---
# BIDBRAIN_REPLAY=1     # answer only from the recorded LLM cache (offline demo)
# SESSION_TTL=86400     # seconds a visitor's graph copy survives inactivity
# CORS_ORIGINS=*

# --- identity for shared company memory (backend/bidbrain/api/auth.py) ---
# Promote / retire / contest company rules and approve / publish / retire / contest company-record facts need a
# signed-in principal. With none configured those are disabled (fail closed); session-local work needs no login.
# Entries are name:role:sha256hex(secret), comma-separated (or a path to a JSON file of {name, role, sha256}).
# Roles: bid_manager | approver | admin. `python scripts/make_demo_principals.py` fills these for a local demo.
BIDBRAIN_PRINCIPALS=
BIDBRAIN_AUTH_KEY=
# BIDBRAIN_AUTH_TTL=28800               # token lifetime, seconds
# BIDBRAIN_AUTH_COOKIE_SAMESITE=lax     # none (+Secure) when the UI is on another site; pair with explicit CORS_ORIGINS
# BIDBRAIN_DEMO_SECRET_MANAGER=         # written by make_demo_principals.py (plaintext, local demo only)
# BIDBRAIN_DEMO_SECRET_APPROVER=
# ORG_ADMIN_TOKEN=                      # operator override (X-Admin-Token header)
